@model Kategori

@{
    ViewBag.Title = "title";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<h1>Kategori ekleme sayfası</h1>

<form asp-action="Ekle" asp-controller="Kategori" method="post">
    <label asp-for="Ad"></label>
    <input type="text" class="form-control" asp-for="Ad" />
    <br />
    <input type="submit" value="Kaydet" class="btn btn-success" />
</form>
