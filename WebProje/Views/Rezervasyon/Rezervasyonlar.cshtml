@model IEnumerable<WebProje.Models.Rezervasyon>
@{
    ViewBag.Title = "title";
    Layout = "AdminLayout";
    var successModel = ViewData["SuccessRezervasyon"] as PaginatedList<Rezervasyon>;

}

<br/>
<h3>ONAY BEKLEYEN REZERVASYONLAR</h3>
<br/>
<table class="table table-bordered">
    <tr>
        <th>AD SOYAD</th>
        <th>TELEFON</th>
        <th>E POSTA</th>
        <th>KİŞİ SAYISI</th>
        <th>ZAMAN</th>
        <th>AKSİYON</th>
    </tr>
    @foreach(var u in Model)
    {
        <tr>
            <td>@u.Name</td>
            <td>@u.Phone</td>
            <td>@u.Mail</td>
            <td>@u.PersonCount</td>
            <td>@u.Date</td>
            <td>
                <a href="/Rezervasyon/Success/@u.Id" class="btn btn-success">ONAYLA</a>
            </td>

        </tr>
    }
</table>

<br/>
<h3>ONAYLANAN REZERVASYONLAR</h3>
<br/>
<table class="table table-bordered">
    <tr>
        <th>AD SOYAD</th>
        <th>TELEFON</th>
        <th>E POSTA</th>
        <th>KİŞİ SAYISI</th>
        <th>ZAMAN</th>
    </tr>
    @foreach(var u in successModel.Items)
    {
        <tr>
            <td>@u.Name</td>
            <td>@u.Phone</td>
            <td>@u.Mail</td>
            <td>@u.PersonCount</td>
            <td>@u.Date</td>
        </tr>
    }
</table>

<nav>
    <ul class="pagination">
        @* eğer öncesinde syafa varsa 'Önceki' butonu oluşturur *@
        @if (successModel.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Rezervasyonlar", new { pageNumber = successModel.PageNumber - 1 })">Önceki</a>
            </li>
        }
        @* toplam sayfa sayısı kadar buton koyma *@
        @for (int i = 1; i <= successModel.TotalPages; i++)
        {
            <li class="page-item @(i == successModel.PageNumber ? "active" : "")">
                <a class="page-link" href="@Url.Action("Rezervasyonlar", new { pageNumber = i })">@i</a>
            </li>
        }

        @* eğer sonrasında syafa varsa 'Sonraki' butonu oluşturur *@
        @if (successModel.HasNextPage)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Rezervasyonlar", new { pageNumber = successModel.PageNumber + 1 })">Sonraki</a>
            </li>
        }
    </ul>
</nav>