@using Microsoft.AspNetCore.Mvc.TagHelpers
@using WebProje.MyCustomHelpers
@model WebProje.Models.Rezervasyon
@{
    ViewBag.Title = "Rezervasyon";
    Layout = "_Layout";
}

@if (TempData["SweetAlertMesaj"] != null)
{
    <script>
        Swal.fire({
            title: 'Sonuç',
            text: '@TempData["SweetAlertMesaj"]',
            icon: '@(TempData["SweetAlertMesaj"].ToString().Contains("hata") ? "error" : "success")'
        });
    </script>
}

<br />
<h1 style="text-align: center;">Rezervasyon</h1>
<br />

<div class="reservation-container">
    <!-- Sol Taraf: Rezervasyon Formu -->
    <div class="reservation-form">
        <form class="form-group" method="post">
            <br />
            @Html.CustomTextBox("Name", "Ad Soyad")
            <br />
            @Html.CustomPhoneBox("Phone", "Telefon")
            <br />
            @Html.CustomEmailBox("Mail", "E-Posta")
            <br />
            @Html.CustomDropDownList("PersonCount", "Kişi Sayısı", new List<SelectListItem>
            {
                new SelectListItem { Value = "", Text = "Kaç Kişisiniz?", Disabled = true, Selected = true },
                new SelectListItem { Value = "1", Text = "1" },
                new SelectListItem { Value = "2", Text = "2" },
                new SelectListItem { Value = "3", Text = "3" },
                new SelectListItem { Value = "4", Text = "4" },
                new SelectListItem { Value = "5", Text = "5" },
                new SelectListItem { Value = "6", Text = "6+" },
            })
            <br />
            @Html.CustomDateTimePicker("Date", "Zaman")
            <br />
            <button class="btn btn-primary">Rezervasyon Talebi Oluştur</button>
        </form>
    </div>

    <!-- Sağ Taraf: Bilgilendirme -->
    <div class="reservation-info">
        <br />
        <h6>
            *Tarafınıza Mail ile bilgilendirme yapılacaktır.<br /><br />
            *15 DK geciken rezervasyonlar iptal edilir.<br /><br />
            *Tarafınıza Mail Gelmemesi Durumunda İletişim:<br />Tel: 0 505 091 09 00
        </h6>
    </div>
</div>