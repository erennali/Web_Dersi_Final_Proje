@model WebProje.Models.Masa
@{
    ViewBag.Title = "Yeni Masa";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}
<br />
<h2>Yeni Masa Sayfası</h2>
<br />
<form class="form-group" asp-area="Admin" method="post">
    <br />
    @Html.Label("Ad")
    @Html.TextBoxFor(x => x.Ad, new { @class = "form-control" })
    <br />
    <button class="btn btn-primary">Kaydet</button>
</form>

